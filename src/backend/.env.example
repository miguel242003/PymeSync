# --- Servidor ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Base de datos (MySQL) ---
# Ej: mysql://usuario:password@localhost:3306/pymesync
# Free tier recomendado: PlanetScale, Railway o Aiven MySQL
DATABASE_URL="mysql://user:password@localhost:3306/pymesync"

# --- JWT ---
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="reemplazar_por_un_secreto_largo_y_aleatorio"
JWT_EXPIRES_IN="7d"

# --- Resend (https://resend.com, free tier: 3000 emails/mes) ---
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="PymeSync <onboarding@resend.dev>"

# --- Redis (BullMQ) ---
# Local: docker run -d --name pymesync-redis -p 6379:6379 redis:7-alpine
REDIS_URL="redis://localhost:6379"

# --- Meta (WhatsApp / Messenger / Instagram) ---
# App Secret del Meta App: dashboard > Configuración > Básica > "Secreto de la app".
META_APP_SECRET="reemplazar_con_app_secret_de_meta"
# Valor arbitrario inventado por vos (ej: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Se pega también en la configuración del webhook dentro del dashboard de Meta; deben coincidir.
META_VERIFY_TOKEN="reemplazar_con_un_valor_secreto_inventado_por_ti"
